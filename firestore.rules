rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isValidMoment() {
      let data = request.resource.data;
      return isString(data.caption, 500)
        && data.caption.size() > 0
        && isString(data.date, 40)
        && data.date.size() > 0
        && isString(data.photoUrl, 2000)
        && (!('photoPath' in data) || isString(data.photoPath, 1000));
    }

    match /site/{document} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /moments/{momentId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidMoment();
      allow delete: if isSignedIn();
    }
  }
}
